NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AI pipeline sağlayıcısı: "claude" | "gemini" — bkz. src/lib/ai-pipeline/provider.ts.
# Geçici olarak "gemini" kullanılıyor (Anthropic kredi bakiyesi yenilenince "claude"a dönülecek).
AI_PROVIDER=claude
APIFY_TOKEN=
# Scrape maliyet tahmini — PROD'DA ZORUNLU (lokalde opsiyonel):
# analysis_runs.scrape_cost_usd = fetched_reviews × bu değer.
# compass/google-maps-reviews-scraper pay-per-result birim fiyatı (USD/yorum); BOŞSA maliyet null loglanır
# ve kullanıcı başı maliyet kör noktada kalır — 2026-08 pilotunda 7 koşunun hepsinde bu yüzden null yazıldı.
# Neden önemli: tek bir analiz döngüsü 3 rakiple 720 yorum çekiyor; 10 rakipli yoğun bir klinikte bu 3-4
# katına çıkabilir ve 29$/ay Pro fiyatında marjı izlemek şart (bkz. docs/11-risks-assumptions.md Bölüm C,
# Risk 3 erken sinyalleri). Değeri Apify actor'ünün güncel pay-per-result fiyatından al.
APIFY_PRICE_PER_REVIEW_USD=
# sian.agency/trustpilot-reviews-scraper birim fiyatı (USD/yorum) — google'dan
# ayrı env, actor farklı ve muhtemelen farklı birim fiyata sahip; boşsa
# maliyet null loglanır.
APIFY_PRICE_PER_TRUSTPILOT_REVIEW_USD=
# Google Places Text Search (işletme bağlama akışındaki isim araması) — bkz. src/lib/google-places/search.ts.
# Cloud Console'da "Places API (New)" etkin bir key olmalı; tanımsızsa /api/business/search 500 döner.
GOOGLE_MAPS_API_KEY=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Pro plan'a karşılık gelen LemonSqueezy variant ID'si (dashboard'da ürün oluşturulunca alınır).
LEMONSQUEEZY_PRO_VARIANT_ID=
# Cron endpoint koruması: /api/cron/* route'ları "Authorization: Bearer ${CRON_SECRET}" bekler.
# Değeri Vercel proje env'ine de girmeyi unutma — tanımsızsa endpoint fail-closed (500) döner.
CRON_SECRET=
